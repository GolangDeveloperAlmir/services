APP_NAME=User Service
APP_ENV=development
APP_ALLOWED_HOSTS=["localhost","127.0.0.1","::1"]
POSTGRES_PASSWORD=replace-with-random-local-value
REDIS_PASSWORD=replace-with-random-local-value
AUTH_SESSION_TTL_SECONDS=900
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_IP_RATE_LIMIT_ATTEMPTS=30
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
DATABASE_URL=postgresql+asyncpg://user_service:replace-with-random-local-value@localhost:5432/user_service_test
REDIS_URL=redis://:replace-with-random-local-value@localhost:6379/0
